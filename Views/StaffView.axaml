<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AvaloniaApplication1.Views.StaffView">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="avares://AvaloniaApplication1/icons/Employees.png"
                       Width="28"
                       Height="28"/>
                <TextBlock Text="Управление сотрудниками" 
                          FontSize="24" 
                          FontWeight="Bold"
                          Foreground="{DynamicResource SystemBaseHighColor}"/>
            </StackPanel>
            
            <TextBlock Text="Создание и управление аккаунтами сотрудников" 
                      FontSize="14"
                      Foreground="{DynamicResource SystemBaseMediumColor}"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <!-- Create New Staff Button -->
                <Button Command="{Binding ToggleCreateModeCommand}"
                       HorizontalAlignment="Left"
                       Classes="Primary">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Image Source="avares://AvaloniaApplication1/icons/plus.png"
                               Width="16"
                               Height="16"/>
                        <TextBlock Text="Создать нового сотрудника" Foreground="White"/>
                    </StackPanel>
                </Button>

                <!-- Cancel Button (visible when creating) -->
                <Button Content="❌ Отмена создания" 
                       Command="{Binding ToggleCreateModeCommand}"
                       HorizontalAlignment="Left"
                       IsVisible="{Binding IsCreatingNew}"/>

                <!-- Create New Staff Form -->
                <Border IsVisible="{Binding IsCreatingNew}"
                       Background="{DynamicResource SystemAltLowColor}"
                       CornerRadius="8"
                       Padding="20"
                       BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                       BorderThickness="1">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Новый сотрудник" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource SystemBaseHighColor}"/>

                        <TextBox Watermark="Номер телефона" 
                                Text="{Binding NewPhone}"/>

                        <Grid ColumnDefinitions="*,*,*">
                            <TextBox Grid.Column="0" Watermark="Фамилия" 
                                    Text="{Binding NewLastName}"/>
                            <TextBox Grid.Column="1" Watermark="Имя" Margin="5,0"
                                    Text="{Binding NewFirstName}"/>
                            <TextBox Grid.Column="2" Watermark="Отчество (необязательно)" 
                                    Text="{Binding NewMiddleName}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Роль:" VerticalAlignment="Center" Foreground="{DynamicResource SystemBaseHighColor}"/>
                            <ComboBox SelectedItem="{Binding SelectedRole}" MinWidth="150">
                                <ComboBox.Items>
                                    <system:String>employee</system:String>
                                    <system:String>owner</system:String>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Создать аккаунт" 
                                   Command="{Binding CreateStaffAccountCommand}"
                                   IsEnabled="{Binding !IsLoading}"
                                   Classes="Primary"/>
                            <Button Content="Очистить" 
                                   Command="{Binding ClearNewUserFormCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Error Message -->
                <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Background="#FEF2F2"
                       CornerRadius="8"
                       Padding="15"
                       BorderBrush="#FCA5A5"
                       BorderThickness="1">
                    <TextBlock Text="{Binding ErrorMessage}" 
                              Foreground="#DC2626"
                              TextWrapping="Wrap"/>
                </Border>

                <!-- Users List -->
                <Border Background="{DynamicResource SystemAltLowColor}"
                       CornerRadius="8"
                       Padding="20"
                       BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                       BorderThickness="1">
                    <StackPanel Spacing="15">
                        <!-- Search Filter -->
                        <TextBox Watermark="🔍 Поиск по телефону или имени..." 
                                Text="{Binding SearchText}"
                                Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Image Source="avares://AvaloniaApplication1/icons/Employees.png"
                                       Width="20"
                                       Height="20"/>
                                <TextBlock Text="Все пользователи" 
                                          FontSize="18" 
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource SystemBaseHighColor}"/>
                            </StackPanel>
                            <Button Command="{Binding RefreshUsersCommand}"
                                   HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Image Source="avares://AvaloniaApplication1/icons/Refrash.png"
                                           Width="16"
                                           Height="16"/>
                                    <TextBlock Text="Обновить"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding FilteredUsers}"
                                 SelectedItem="{Binding SelectedUser}"
                                 AutoGenerateColumns="False"
                                 CanUserResizeColumns="True"
                                 CanUserSortColumns="True"
                                 GridLinesVisibility="Horizontal"
                                 BorderThickness="0"
                                 MinHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Роль" Binding="{Binding Role, Converter={StaticResource RoleDisplayConverter}}" Width="115"/>
                                <DataGridTemplateColumn Header="Действия" Width="550">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Button Command="{Binding $parent[DataGrid].DataContext.PromoteToEmployeeCommand}"
                                                       Classes="Primary">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Image Source="avares://AvaloniaApplication1/icons/employee.png"
                                                               Width="14"
                                                               Height="14"/>
                                                        <TextBlock Text="Сотрудник" Foreground="White"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding $parent[DataGrid].DataContext.PromoteToOwnerCommand}"
                                                       Classes="Primary">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Image Source="avares://AvaloniaApplication1/icons/owner.png"
                                                               Width="14"
                                                               Height="14"/>
                                                        <TextBlock Text="Владелец" Foreground="White"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding $parent[DataGrid].DataContext.DemoteUserCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Image Source="avares://AvaloniaApplication1/icons/downgare.png"
                                                               Width="14"
                                                               Height="14"/>
                                                        <TextBlock Text="Понизить"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding $parent[DataGrid].DataContext.DeleteUserCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="{StaticResource DangerBrush}"
                                                        Foreground="White">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Image Source="avares://AvaloniaApplication1/icons/delete.png"
                                                               Width="14"
                                                               Height="14"/>
                                                        <TextBlock Text="Удалить" Foreground="White"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Indicator -->
        <Border Grid.Row="2" 
               IsVisible="{Binding IsLoading}"
               Background="{DynamicResource SystemAltLowColor}"
               CornerRadius="8"
               Padding="20"
               Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center" 
                       Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="100"/>
                <TextBlock Text="Загрузка..." Foreground="{DynamicResource SystemBaseHighColor}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
