<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:AvaloniaApplication1.Views"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Морепродукты - АРМ Сотрудника"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.blink">
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Top Bar - Uses system accent color -->
        <Border Grid.Row="0" 
               Background="{DynamicResource SystemAccentColor}"
               Padding="15,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
                    <!-- Navigation Buttons -->
                    <Button Command="{Binding NavigateToProductsCommand}"
                           IsVisible="{Binding ShowProducts}"
                           Background="{DynamicResource SystemAccentColor}"
                           Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Source="avares://AvaloniaApplication1/icons/items.png"
                                   Width="20"
                                   Height="20"/>
                            <TextBlock Text="Товары"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Classes.blink="{Binding HasExpiredProducts}"/>
                            <Border IsVisible="{Binding HasExpiredProducts}"
                                    Background="{StaticResource DangerBrush}"
                                    CornerRadius="10"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExpiredProductsCount}"
                                           FontSize="10"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToOrdersCommand}"
                           IsVisible="{Binding ShowOrders}"
                           Background="{DynamicResource SystemAccentColor}"
                           Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Source="avares://AvaloniaApplication1/icons/orders.png"
                                   Width="20"
                                   Height="20"/>
                            <TextBlock Text="Заказы"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Classes.blink="{Binding HasPendingOrders}"/>
                            <Border IsVisible="{Binding HasPendingOrders}"
                                    Background="{StaticResource DangerBrush}"
                                    CornerRadius="10"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding PendingOrdersCount}"
                                           FontSize="10"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToInventoryCommand}"
                           IsVisible="{Binding ShowInventory}"
                           Background="{DynamicResource SystemAccentColor}"
                           Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Source="avares://AvaloniaApplication1/icons/Inventory.png"
                                   Width="20"
                                   Height="20"/>
                            <TextBlock Text="Инвентаризация"
                                       VerticalAlignment="Center"
                                       Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToSupportCommand}"
                           IsVisible="{Binding ShowSupport}"
                           Background="{DynamicResource SystemAccentColor}"
                           Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Source="avares://AvaloniaApplication1/icons/SupportChat.png"
                                   Width="20"
                                   Height="20"/>
                            <TextBlock Text="Поддержка"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Classes.blink="{Binding HasPendingSupport}"/>
                            <Border IsVisible="{Binding HasPendingSupport}"
                                    Background="{StaticResource DangerBrush}"
                                    CornerRadius="10"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding PendingSupportCount}"
                                           FontSize="10"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToStaffCommand}"
                           IsVisible="{Binding ShowStaffManagement}"
                           Background="{DynamicResource SystemAccentColor}"
                           Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Source="avares://AvaloniaApplication1/icons/Employees.png"
                                   Width="20"
                                   Height="20"/>
                            <TextBlock Text="Сотрудники"
                                       VerticalAlignment="Center"
                                       Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- User Info, Theme Toggle and Logout -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUser.FullName}" 
                              Foreground="White" 
                              FontSize="14"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsLoggedIn}"/>
                    
                    <!-- Theme Toggle Button - Compact size -->
                    <Button Command="{Binding ToggleThemeCommand}"
                           VerticalAlignment="Center"
                           Background="Transparent"
                           Padding="2"
                           Width="28"
                           Height="28">
                        <Image Source="{Binding IsDarkMode, Converter={StaticResource ThemeIconConverter}}"
                               Width="18"
                               Height="18"/>
                    </Button>
                    
                    <Button Content="Выход" 
                           Command="{Binding LogoutCommand}"
                           IsVisible="{Binding IsLoggedIn}"
                           Background="{DynamicResource SystemAltMediumColor}"
                           Foreground="{DynamicResource SystemBaseHighColor}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area - Uses system theme background -->
        <Border Grid.Row="1" 
               Background="{DynamicResource SystemBaseLowColor}">
            <Grid>
                <!-- Current View Content - constrained to available space -->
                <ContentControl Content="{Binding CurrentView}" 
                               Margin="0,10,0,10"
                               VerticalAlignment="Stretch"
                               HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>
    </Grid>
</Window>
