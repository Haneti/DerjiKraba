<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:AvaloniaApplication1.Views"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="AvaloniaApplication1.Views.OrdersView">

    <Grid RowDefinitions="Auto,*" Margin="20">
        <!-- Header - Matching mobile app style -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <TextBlock Text="🛒 Управление заказами" 
                      FontSize="24" 
                      FontWeight="Bold"
                      Foreground="{DynamicResource SystemBaseHighColor}"/>
            
            <Button Grid.Column="1" 
                   Content="Обновить" 
                   Command="{Binding LoadOrdersCommand}"
                   Classes="Primary"
                   Background="#3B82F6"
                   Foreground="White"/>
        </Grid>

        <!-- Main Content - Clean white background -->
        <Grid Grid.Row="1" ColumnDefinitions="*,400">
            <!-- Orders List -->
            <Border Grid.Column="0" 
                   BorderBrush="{DynamicResource SystemBaseMediumLowColor}" 
                   BorderThickness="1" 
                   CornerRadius="5"
                   Margin="0,0,10,0"
                   Background="{DynamicResource SystemAltHighColor}"
                   IsVisible="{Binding !SelectedOrder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid ItemsSource="{Binding Orders}"
                             SelectedItem="{Binding SelectedOrder}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             CanUserResizeColumns="True"
                             CanUserSortColumns="True"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id, StringFormat={}{0:0000}}" Width="120"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding Customer.FullName}" Width="220"/>
                            <DataGridTemplateColumn Header="Телефон" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Customer.Phone}" 
                                                   VerticalAlignment="Center"
                                                   Margin="5,0"
                                                   Foreground="{DynamicResource SystemAccentColor}"
                                                   Cursor="Hand"
                                                   DoubleTapped="OnPhoneDoubleTapped"
                                                   Tag="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:F2} ₽}" Width="120"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding DeliveryTypeDisplay}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Border>

            <!-- Order Details Panel - Theme aware -->
            <Border Grid.Column="1" 
                   Background="{DynamicResource SystemAltMediumColor}" 
                   CornerRadius="5" 
                   Padding="15"
                   Margin="10,0,0,0"
                   IsVisible="{Binding SelectedOrder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Детали заказа" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"
                                  Foreground="{DynamicResource SystemBaseHighColor}"/>

                        <!-- Order Info -->
                        <Border Background="{DynamicResource SystemAltHighColor}" CornerRadius="5" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource SystemBaseMediumLowColor}">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="14">
                                    <Run FontWeight="Bold">Заказ №</Run>
                                    <Run Text="{Binding SelectedOrder.Id}"/>
                                </TextBlock>
                                <TextBlock FontSize="14">
                                    <Run FontWeight="Bold">Дата:</Run>
                                    <Run Text="{Binding SelectedOrder.OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                </TextBlock>
                                <TextBlock FontSize="14">
                                    <Run FontWeight="Bold">Статус:</Run>
                                    <Run Text="{Binding SelectedOrder.StatusDisplay}"/>
                                </TextBlock>
                                <TextBlock FontSize="14">
                                    <Run FontWeight="Bold">Тип доставки:</Run>
                                    <Run Text="{Binding SelectedOrder.DeliveryTypeDisplay}"/>
                                </TextBlock>
                                <TextBlock FontSize="14" IsVisible="{Binding SelectedOrder.DeliveryAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Run FontWeight="Bold">Адрес:</Run>
                                    <Run Text="{Binding SelectedOrder.DeliveryAddress}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Customer Info -->
                        <Border Background="{DynamicResource SystemAltHighColor}" CornerRadius="5" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource SystemBaseMediumLowColor}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Клиент" FontWeight="Bold" FontSize="14"/>
                                <TextBlock FontSize="14" Text="{Binding SelectedOrder.Customer.FullName}"/>
                                <TextBlock FontSize="14" DoubleTapped="OnPhoneDoubleTapped" Tag="{Binding SelectedOrder}" Cursor="Hand">
                                    <Run>📞 </Run>
                                    <Run Text="{Binding SelectedOrder.Customer.Phone}" Foreground="{DynamicResource SystemAccentColor}"/>
                                </TextBlock>
                                <TextBlock FontSize="14" IsVisible="{Binding SelectedOrder.Customer.Address, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Run>📍 </Run>
                                    <Run Text="{Binding SelectedOrder.Customer.Address}"/>
                                </TextBlock>
                                <Button Content="📋 История заказов" 
                                        Command="{Binding OpenCustomerStatsCommand}"
                                        CommandParameter="{Binding SelectedOrder.UserId}"
                                        Background="{DynamicResource SystemAccentColor}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Padding="8,4"
                                        FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Delivery Details -->
                        <Border Background="{DynamicResource SystemAltHighColor}" CornerRadius="5" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                                IsVisible="{Binding SelectedOrder.ParsedDeliveryDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="🚚 Детали доставки" FontWeight="Bold" FontSize="14"/>
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontSize="13" TextWrapping="Wrap" IsVisible="{Binding SelectedOrder.ParsedDeliveryDetails.Address, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <Run FontWeight="SemiBold">Адрес: </Run>
                                            <Run Text="{Binding SelectedOrder.ParsedDeliveryDetails.Address}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="13" TextWrapping="Wrap" IsVisible="{Binding SelectedOrder.ParsedDeliveryDetails.Entrance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <Run FontWeight="SemiBold">Подъезд: </Run>
                                            <Run Text="{Binding SelectedOrder.ParsedDeliveryDetails.Entrance}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="13" TextWrapping="Wrap" IsVisible="{Binding SelectedOrder.ParsedDeliveryDetails.Floor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <Run FontWeight="SemiBold">Этаж: </Run>
                                            <Run Text="{Binding SelectedOrder.ParsedDeliveryDetails.Floor}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="13" TextWrapping="Wrap" IsVisible="{Binding SelectedOrder.ParsedDeliveryDetails.Apartment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <Run FontWeight="SemiBold">Квартира: </Run>
                                            <Run Text="{Binding SelectedOrder.ParsedDeliveryDetails.Apartment}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="13" TextWrapping="Wrap" IsVisible="{Binding SelectedOrder.ParsedDeliveryDetails.Intercom, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <Run FontWeight="SemiBold">Домофон: </Run>
                                            <Run Text="{Binding SelectedOrder.ParsedDeliveryDetails.Intercom}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="13" IsVisible="{Binding SelectedOrder.ParsedDeliveryDetails.IntercomBroken}">
                                            <Run Foreground="#DC2626">⚠️ Домофон не работает</Run>
                                        </TextBlock>
                                        <TextBlock FontSize="13" IsVisible="{Binding SelectedOrder.ParsedDeliveryDetails.Latitude, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Run FontWeight="SemiBold">Координаты: </Run>
                                            <Run Text="{Binding SelectedOrder.ParsedDeliveryDetails.Latitude}"/>
                                            <Run>, </Run>
                                            <Run Text="{Binding SelectedOrder.ParsedDeliveryDetails.Longitude}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Order Items -->
                        <Border Background="{DynamicResource SystemAltHighColor}" CornerRadius="5" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource SystemBaseMediumLowColor}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Товары" FontWeight="Bold" FontSize="14"/>
                                <ItemsControl ItemsSource="{Binding SelectedOrder.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SystemAltLowColor}" 
                                                   CornerRadius="5" 
                                                   Padding="8"
                                                   Margin="0,0,0,5">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" Foreground="{DynamicResource SystemBaseHighColor}"/>
                                                        <TextBlock Foreground="{DynamicResource SystemBaseMediumColor}">
                                                            <Run Text="{Binding Quantity}"/>
                                                            <Run> × </Run>
                                                            <Run Text="{Binding PricePerKg, StringFormat={}{0:F2} ₽}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" 
                                                              Text="{Binding Total, StringFormat={}{0:F2} ₽}" 
                                                              FontWeight="Bold"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator/>
                                
                                <Grid ColumnDefinitions="*,*">
                                    <TextBlock Text="Итого:" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Grid.Column="1" 
                                              Text="{Binding SelectedOrder.TotalAmount, StringFormat={}{0:F2} ₽}" 
                                              FontWeight="Bold" 
                                              FontSize="16"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Notes -->
                        <TextBox Text="{Binding SelectedOrder.Notes}" 
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                Height="60"
                                Watermark="Комментарий к заказу"
                                IsVisible="{Binding SelectedOrder.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- Status Update Buttons -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Изменить статус" FontWeight="Bold" FontSize="14"/>
                            
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="Ожидает" 
                                       Command="{Binding UpdateOrderStatusCommand}"
                                       CommandParameter="pending"
                                       Background="#6B7280"
                                       Foreground="White"
                                       Margin="2"/>
                                <Button Content="В обработке" 
                                       Command="{Binding UpdateOrderStatusCommand}"
                                       CommandParameter="processing"
                                       Background="#3B82F6"
                                       Foreground="White"
                                       Margin="2"/>
                                <Button Content="Готов" 
                                       Command="{Binding UpdateOrderStatusCommand}"
                                       CommandParameter="ready"
                                       Background="#10B981"
                                       Foreground="White"
                                       Margin="2"/>
                                <Button Content="Доставляется" 
                                       Command="{Binding UpdateOrderStatusCommand}"
                                       CommandParameter="delivering"
                                       Background="#8B5CF6"
                                       Foreground="White"
                                       Margin="2"/>
                                <Button Content="Завершен" 
                                       Command="{Binding UpdateOrderStatusCommand}"
                                       CommandParameter="completed"
                                       Background="#059669"
                                       Foreground="White"
                                       Margin="2"/>
                                <Button Content="Отменен" 
                                       Command="{Binding UpdateOrderStatusCommand}"
                                       CommandParameter="cancelled"
                                       Background="#6B7280"
                                       Foreground="White"
                                       Margin="2"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding ErrorMessage}" 
                                  Foreground="#DC2626" 
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Empty State -->
            <Border Grid.Column="0" 
                   Background="{DynamicResource SystemAltLowColor}" 
                   CornerRadius="5"
                   IsVisible="{Binding !HasOrders}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="🛒" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Нет заказов" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource SystemBaseHighColor}"/>
                    <TextBlock Text="Заказы появятся здесь" 
                              TextWrapping="Wrap"
                              TextAlignment="Center"
                              Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Customer Stats Overlay -->
        <Border Grid.Row="1" 
                Grid.ColumnSpan="2"
                Background="{DynamicResource SystemAltHighColor}"
                CornerRadius="8"
                IsVisible="{Binding ShowCustomerStats}"
                Margin="40"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemBaseMediumLowColor}">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="15,10">
                    <TextBlock Grid.Column="0" Text="История клиента" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource SystemBaseHighColor}"/>
                    <Button Grid.Column="1" Content="✕ Закрыть" 
                            Command="{Binding CloseCustomerStatsCommand}"
                            Background="#DC2626"
                            Foreground="White"
                            Padding="10,4"/>
                </Grid>
                <ContentControl Grid.Row="1" 
                                Content="{Binding CustomerStatsViewModel}" 
                                Margin="0,0,0,10"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
